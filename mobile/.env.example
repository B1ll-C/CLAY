# Mobile environment configuration.
# Copy to .env (gitignored) and fill in real values. Expo/Metro inlines any
# EXPO_PUBLIC_* var automatically — no plugin needed.

# Base URL of the Phase 8 backend (see backend/.env.example / docker-compose.yml).
# - Android emulator: use 10.0.2.2 instead of localhost to reach the host machine.
# - Physical device: use your machine's LAN IP (e.g. http://192.168.1.20:3000).
EXPO_PUBLIC_API_URL=http://localhost:3000
