# Backend environment configuration.
# Copy to .env (gitignored) and fill in real values.

# PostgreSQL connection string used by Drizzle (src/db) and the migration runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clay

# Redis connection string — refresh tokens (Phase 8 auth), barcode lookup
# cache, and BullMQ's CleanupWorker.
REDIS_URL=redis://localhost:6379

# HTTP port for the Fastify server (defaults to 3000).
PORT=3000

# Host ports docker-compose.yml maps its Postgres/Redis containers to
# (only used by docker-compose.yml, not the app itself).
POSTGRES_PORT=5432
REDIS_PORT=6379
