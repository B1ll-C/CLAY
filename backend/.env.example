# Backend environment configuration.
# Copy to .env (gitignored) and fill in real values.

# Supabase project — Postgres is hosted, not local. See docs/Supabase.md for
# how to create the project and where each value below comes from.

# Settings -> Database -> Connection string -> Session pooler (this backend
# is a long-running server, not serverless, but the pooler avoids needing
# IPv6 support on your network). Drizzle (src/db) and the migration runner
# both use this.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Backend-only — never send this to mobile. Used solely to revoke sessions at logout.
SUPABASE_SECRET_KEY=

# Redis connection string — barcode lookup cache and BullMQ's CleanupWorker.
REDIS_URL=redis://localhost:6379

# HTTP port for the Fastify server (defaults to 3000).
PORT=3000

# Host port docker-compose.yml maps its Redis container to (only used by
# docker-compose.yml, not the app itself).
REDIS_PORT=6379
